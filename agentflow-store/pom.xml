<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>agentflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>agentflow-store</artifactId>
  <name>agentflow-store</name>
  <description>运行态模型与存储：WorkflowInstance 聚合根（步骤状态 / 变量 / 快照链 / 挂起审批单）、RunSnapshot 回退历史点、RunStore 存储 SPI 与其有界 LRU 内存实现。依赖 agentflow-contract，不依赖引擎。</description>

  <!--
    为什么把聚合根与存储放在同一模块：WorkflowInstance 的唯一持久化出口就是 RunStore，
    存储实现的容量上限、淘汰可观测性都直接约束聚合根上快照链的增长；
    拆开后 core 只依赖本模块的接口与模型，替换 JDBC 实现时引擎无感。
  -->
  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>agentflow-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/package-info.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
