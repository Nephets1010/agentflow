<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>agentflow</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>agentflow-contract</artifactId>
  <name>agentflow-contract</name>
  <description>公共契约（零依赖，不含 slf4j）：全部异常类型、RunStatus/StepStatus 步骤与运行状态枚举、ApprovalDecision 人工裁决枚举。core 与 store 共用同一套包名，靠本模块保证“状态机取值与异常签名”只有一处定义。</description>

  <!--
    ★ 本模块刻意不依赖任何第三方库（连 slf4j 都不引）。
      契约被 core / store / starter 同时依赖，依赖越少，被它拖住的风险面越小；
      异常与状态枚举是纯数据，没有日志需求，引入日志门面只会扩大传递依赖。
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/package-info.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
